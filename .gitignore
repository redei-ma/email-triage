.DS_Store
._*
.vscode/
.idea/
*.swp
*~
.claude/
CLAUDE.md

# ---- Node / TypeScript (keep only if the project uses it) --------------
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# ---- this project: evaluation runs --------------------------------------
